---
import type { WorkStep } from '../data/profile';
import Rich from './Rich.astro';

type Props = {
  title: string;
  paragraphs: string[];
  steps: WorkStep[];
};
const { title, paragraphs, steps } = Astro.props;
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="section__head" data-reveal>
      <span class="eyebrow">About</span>
      <h2 class="section__title" id="about-title">{title}</h2>
    </div>
    <div class="about__grid">
      <span aria-hidden="true"></span>
      <div class="about__body">
        {paragraphs.map((p, i) => <p data-reveal style={`--i:${i}`}><Rich text={p} /></p>)}
      </div>
    </div>
    <ol class="steps" aria-label="How I work now">
      {steps.map((step, i) => (
        <li class="step" data-reveal style={`--i:${i}`}>
          <h3>{step.name}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
