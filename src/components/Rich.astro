---
// Renders inline emphasis from data strings: **accent text** and ==highlighter mark==.
type Props = { text: string };
const parts = Astro.props.text.split(/(\*\*[^*]+\*\*|==[^=]+==)/g).filter(Boolean);
---

{parts.map((part) =>
  part.startsWith('**') ? (
    <strong class="em">{part.slice(2, -2)}</strong>
  ) : part.startsWith('==') ? (
    <mark class="hl">{part.slice(2, -2)}</mark>
  ) : (
    part
  )
)}
