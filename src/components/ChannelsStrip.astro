---
import type { Channel } from '../data/profile';
import Arrow from './icons/Arrow.astro';
import SocialIcon from './icons/SocialIcon.astro';

type Props = { links: Channel[] };
const { links } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class="channels">
  <div class="container channels__row" data-reveal>
    <span class="eyebrow channels__label">Published on</span>
    <ul class="channels__list">
      {links.map((link) => (
        <li>
          <a class="channel" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.icon === 'vscode' && (
              <svg class="channel__icon channel__icon--vscode" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.15 2.59 18.21.21a1.49 1.49 0 0 0-1.7.29L7.04 9.13 2.92 6a1 1 0 0 0-1.27.06L.33 7.26a1 1 0 0 0 0 1.48L3.9 12 .33 15.26a1 1 0 0 0 0 1.48l1.32 1.2a1 1 0 0 0 1.27.06l4.12-3.13 9.46 8.63a1.49 1.49 0 0 0 1.7.29l4.95-2.38A1.5 1.5 0 0 0 24 20.06V3.94a1.5 1.5 0 0 0-.85-1.35ZM18 17.45 10.83 12 18 6.55v10.9Z" />
              </svg>
            )}
            {link.icon === 'openvsx' && (
              <img class="channel__icon" src={`${base}icons/openvsx.png`} alt="" width="64" height="64" />
            )}
            {link.icon === 'github' && <SocialIcon name="github" />}
            <span class="channel__label">{link.label}</span>
            <Arrow />
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
