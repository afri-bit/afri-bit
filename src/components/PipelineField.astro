<!-- Ambient background: small pipelines (idea → vision → plan → build → product → ship) that assemble and fade. -->
<div class="pipeline" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- One shared soft glow; drawn as a gradient so no blur filter is needed. -->
      <radialGradient id="pipe-glow">
        <stop offset="0" stop-color="currentColor" stop-opacity="0.6" />
        <stop offset="0.45" stop-color="currentColor" stop-opacity="0.22" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0" />
      </radialGradient>
    </defs>
  </svg>
</div>

<script>
  const svg = document.querySelector<SVGSVGElement>('.pipeline svg');
  const NS = 'http://www.w3.org/2000/svg';

  // Line icons, 24×24 viewBox (Lucide-style paths).
  const ICONS: Record<string, string> = {
    idea: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
    vision: '<path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0"/><circle cx="12" cy="12" r="3"/>',
    plan: '<path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>',
    build: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
    car: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
    home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .7-1.53l7-6a2 2 0 0 1 2.6 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
    tool: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
    chip: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/>',
    ship: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  };

  const STAGES: [string, string][] = [
    ['idea', 'idea'],
    ['vision', 'vision'],
    ['plan', 'plan'],
    ['build', 'build'],
  ];
  const PRODUCTS: [string, string][] = [
    ['car', 'automotive'],
    ['home', 'smart home'],
    ['tool', 'dev tools'],
    ['chip', 'embedded'],
  ];

  const rand = (min: number, max: number) => min + Math.random() * (max - min);
  const pick = <T,>(list: T[]) => list[Math.floor(Math.random() * list.length)];
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  const make = (tag: string, attrs: Record<string, string | number>, parent: Element) => {
    const node = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
    parent.appendChild(node);
    return node;
  };

  type Point = { x: number; y: number };

  const layout = (count: number, band: number): { points: Point[]; box: number } => {
    const W = window.innerWidth;
    const H = window.innerHeight;
    const small = W < 720;
    const box = small ? 34 : 46;
    const step = small ? 74 : 170;
    const margin = box;
    const top = band === 0 ? H * 0.14 : H * 0.56;
    const bottom = band === 0 ? H * 0.44 : H * 0.86;

    const span = step * (count - 1);
    let x = rand(margin, Math.max(margin, W - span - margin));
    let y = rand(top, bottom);
    const points = [{ x, y }];
    for (let i = 1; i < count; i++) {
      const nx = x + rand(step * 0.8, step * 1.15);
      if (nx > W - margin) {
        // Out of room: turn the corner and continue downward.
        y = Math.min(H - margin, y + box * 2.4);
      } else {
        x = nx;
        y = Math.max(margin * 1.5, Math.min(H - margin, y + rand(-step * 0.45, step * 0.45)));
      }
      points.push({ x, y });
    }
    return { points, box };
  };

  const elbow = (a: Point, b: Point, box: number) => {
    if (Math.abs(a.x - b.x) < 1) return `M ${a.x} ${a.y + box / 2} V ${b.y - box / 2}`;
    const x1 = a.x + box / 2;
    const x2 = b.x - box / 2;
    const mid = (x1 + x2) / 2;
    return `M ${x1} ${a.y} H ${mid} V ${b.y} H ${x2}`;
  };

  // One strength everywhere: visible at the edges, quiet enough behind text.
  const OPACITY = 0.2;

  const addNode = (parent: Element, p: Point, box: number, icon: string, label: string) => {
    const anchor = make('g', { transform: `translate(${p.x} ${p.y})`, opacity: OPACITY }, parent);
    const node = make('g', { class: 'pipe-node' }, anchor);
    make('circle', { class: 'pipe-glow', r: box * 1.5, fill: 'url(#pipe-glow)' }, node);
    make('rect', { class: 'pipe-halo', x: -box / 2, y: -box / 2, width: box, height: box, rx: 10 }, node);
    make('rect', { x: -box / 2, y: -box / 2, width: box, height: box, rx: 10 }, node);
    const s = (box * 0.5) / 24;
    const glyph = make('g', { class: 'pipe-icon', transform: `scale(${s}) translate(-12 -12)` }, node);
    glyph.innerHTML = ICONS[icon];
    const text = make('text', { y: box / 2 + 15, 'text-anchor': 'middle', class: 'pipe-label' }, node);
    text.textContent = label;
    return node;
  };

  const drawLink = async (parent: Element, d: string, fade: number, animate: boolean) => {
    const path = make('path', { d, class: 'pipe-link', opacity: fade.toFixed(2) }, parent) as SVGPathElement;
    if (!animate) return;
    const len = path.getTotalLength();
    path.style.strokeDasharray = `${len}`;
    path.style.strokeDashoffset = `${len}`;
    const halo = make('circle', { r: 14, class: 'pipe-packet-halo', fill: 'url(#pipe-glow)', opacity: Math.min(1, fade * 1.6).toFixed(2) }, parent);
    const packet = make('circle', { r: 2.5, class: 'pipe-packet', opacity: fade.toFixed(2) }, parent);
    const duration = 650;
    const start = performance.now();
    await new Promise<void>((done) => {
      const frame = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 2);
        const pt = path.getPointAtLength(len * eased);
        packet.setAttribute('cx', `${pt.x}`);
        packet.setAttribute('cy', `${pt.y}`);
        halo.setAttribute('cx', `${pt.x}`);
        halo.setAttribute('cy', `${pt.y}`);
        path.style.strokeDashoffset = `${len * (1 - eased)}`;
        if (t < 1) requestAnimationFrame(frame);
        else done();
      };
      requestAnimationFrame(frame);
    });
    packet.remove();
    halo.remove();
  };

  const runChain = async (band: number, animate: boolean) => {
    if (!svg) return;
    const steps = [...STAGES, pick(PRODUCTS), ['ship', 'ship'] as [string, string]];
    const { points, box } = layout(steps.length, band);
    const chain = make('g', { class: 'pipe-chain' }, svg);
    const links = make('g', {}, chain);

    for (let i = 0; i < steps.length; i++) {
      if (i > 0) {
        await drawLink(links, elbow(points[i - 1], points[i], box), OPACITY, animate);
      }
      const node = addNode(chain, points[i], box, steps[i][0], steps[i][1]);
      if (animate) {
        node.getBoundingClientRect(); // commit the start state before transitioning
        node.classList.add('is-in');
        await sleep(260);
      } else {
        node.classList.add('is-in');
      }
    }

    if (!animate) return;
    await sleep(2600);
    chain.classList.add('is-out');
    await sleep(1300);
    chain.remove();
  };

  if (svg) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      runChain(1, false);
    } else {
      (async () => {
        let band = 0;
        for (;;) {
          if (!document.hidden) runChain(band, true);
          band = 1 - band;
          await sleep(6500);
        }
      })();
    }
  }
</script>
