---
import type { Project } from '../data/profile';
import Arrow from './icons/Arrow.astro';

type Props = { projects: Project[] };
const { projects } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = (path: string) => (/^https?:\/\//.test(path) ? path : `${base}${path}`);

const langColor: Record<string, string> = {
  TypeScript: '#3178c6',
  Go: '#00add8',
  Python: '#3572a5',
};
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="section__head" data-reveal>
      <span class="eyebrow">Selected work</span>
      <h2 class="section__title" id="work-title">Open-source tools, used by engineers <span class="em">every day</span>.</h2>
    </div>

    <ol class="work-list">
      {projects.map((project, i) => (
        <li class="work-item" data-reveal>
          <span class="work-item__index">{String(i + 1).padStart(2, '0')}</span>
          {project.image && (
            <div class:list={['work-item__icon', project.image.fit === 'contain' && 'work-item__icon--contain']}>
              <img src={src(project.image.src)} alt={project.image.alt} width="96" height="96" loading="lazy" decoding="async" />
            </div>
          )}
          <div class="work-item__main">
            <h3 class="work-item__name">{project.name}</h3>
            <p class="work-item__summary">{project.summary}</p>
            <p class="work-item__detail">{project.detail}</p>
          </div>
          <div class="work-item__aside">
            <ul class="work-item__facts">
              <li><span class="lang-dot" style={`--dot:${langColor[project.language] ?? ''}`} aria-hidden="true"></span>{project.language}</li>
              {project.stars !== undefined && (
                <li class="stars">
                  <svg class="star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.53L12 17.49l-5.87 3.08 1.12-6.53L2.5 9.41l6.56-.95L12 2.5z" />
                  </svg>
                  {project.stars} GitHub {project.stars === 1 ? 'star' : 'stars'}
                </li>
              )}
              {project.reach?.map((line) => <li>{line}</li>)}
            </ul>
            <ul class="work-item__links">
              {project.links.map((link) => (
                <li>
                  <a class="link-arrow" href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label} <Arrow /><span class="sr-only"> for {project.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <span class="draw-rule" aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
</section>
